---
import { Phone } from 'lucide-astro'
---

<!-- Mobile-only call button — bottom left -->
<a
  href="tel:+917502979296"
  id="call-btn"
  class="fixed bottom-5 left-5 z-40 flex items-center justify-center w-14 h-14 bg-navy text-white rounded-full shadow-lg lg:hidden opacity-0 translate-y-4 transition-all duration-300 pointer-events-none"
  aria-label="Call N Accounts"
>
  <Phone class="w-5 h-5" />
</a>

<script>
  // Show call button after scrolling past 300px (mobile only)
  const callBtn = document.getElementById('call-btn')
  if (callBtn) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 300) {
        callBtn.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none')
        callBtn.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto')
      } else {
        callBtn.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none')
        callBtn.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto')
      }
    }, { passive: true })

    callBtn.addEventListener('click', () => {
      window.dataLayer?.push({ event: 'phone_click', location: 'floating_button' })
    })
  }
</script>
