---
import { MessageCircle } from 'lucide-astro'
import { contact } from '@data/contact'
---

<a
  href={`https://wa.me/${contact.whatsappNumber}?text=${encodeURIComponent('Hi N Accounts, I am interested in your services.')}`}
  target="_blank"
  rel="noopener noreferrer"
  class="fixed bottom-5 right-5 lg:bottom-8 lg:right-8 z-40 group"
  aria-label="Chat on WhatsApp"
>
  <!-- Pulse ring -->
  <span class="absolute inset-0 rounded-full bg-whatsapp animate-pulse-ring" aria-hidden="true"></span>

  <!-- Button -->
  <span class="relative flex items-center justify-center w-14 h-14 bg-whatsapp text-white rounded-full shadow-wa group-hover:scale-110 transition-transform duration-200">
    <MessageCircle class="w-6 h-6" />
  </span>
</a>

<script>
  // Track WhatsApp click
  document.querySelector('a[aria-label="Chat on WhatsApp"]')?.addEventListener('click', () => {
    window.dataLayer?.push({ event: 'whatsapp_click', location: 'floating_button' })
  })
</script>
