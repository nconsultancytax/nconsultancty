---
import Button from '@components/ui/Button.astro'
import { ArrowRight, Calendar, MessageCircle, Users, IndianRupee, Briefcase } from 'lucide-astro'
import { contact } from '@data/contact'
---

<section class="relative bg-navy-gradient overflow-hidden">
  <!-- Pattern overlay -->
  <div class="absolute inset-0 hero-pattern" aria-hidden="true"></div>

  <div class="container relative z-10 py-16 md:py-20 lg:py-24">
    <div class="flex flex-col lg:flex-row items-center gap-10 lg:gap-16">

      <!-- Left content -->
      <div class="w-full lg:w-1/2 text-center lg:text-left" data-reveal="left">
        <!-- Label chip -->
        <span class="inline-block px-4 py-1.5 mb-5 text-xs font-semibold uppercase tracking-wider text-amber bg-amber/10 rounded-pill">
          100% Online &middot; Pan-India Service
        </span>

        <!-- Headline -->
        <h1 class="font-heading font-bold text-3xl md:text-4xl lg:text-5xl text-white leading-tight text-balance mb-4">
          Professional Accounting & Tax Services for
          <span class="text-amber">Individuals and Businesses</span>
        </h1>

        <!-- Tagline -->
        <p class="text-lg md:text-xl text-amber/80 font-heading font-medium italic mb-4">
          Act Wise & Act Precise on Your Finances
        </p>

        <!-- Supporting text -->
        <p class="text-base text-white/70 mb-8 max-w-lg mx-auto lg:mx-0">
          Trusted by individuals and businesses across India &mdash; 100% online, accurate, and affordable.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-center gap-3 justify-center lg:justify-start">
          <Button href="/services/" variant="primary" size="lg">
            Explore Our Services
            <ArrowRight class="w-4 h-4" />
          </Button>
          <Button
            href={`https://wa.me/${contact.whatsappNumber}?text=${encodeURIComponent('Hi N Accounts, I would like a free consultation.')}`}
            variant="ghost"
            size="lg"
            target="_blank"
            rel="noopener noreferrer"
          >
            Get a Free Consultation
          </Button>
        </div>
      </div>

      <!-- Right column — Consultation card -->
      <div class="w-full lg:w-1/2 flex justify-center lg:justify-end" data-reveal="right">
        <div class="w-full max-w-sm relative">
          <!-- Glow effect behind card -->
          <div class="absolute -inset-1 bg-gradient-to-br from-amber/20 via-transparent to-amber/10 rounded-[20px] blur-xl" aria-hidden="true"></div>

          <!-- Card -->
          <div class="relative bg-white rounded-card-lg shadow-xl overflow-hidden">
            <!-- Gold accent bar -->
            <div class="h-1 bg-gradient-to-r from-amber via-amber-dark to-amber" aria-hidden="true"></div>

            <div class="p-6 sm:p-7">
              <!-- Header -->
              <div class="flex items-center gap-3 mb-5">
                <div class="w-11 h-11 flex items-center justify-center rounded-card bg-amber/10 text-amber">
                  <Calendar class="w-5 h-5" />
                </div>
                <div>
                  <p class="font-heading font-bold text-navy text-base leading-snug">Free Consultation</p>
                  <p class="text-xs text-text-mid mt-0.5">No obligation &middot; 100% online</p>
                </div>
              </div>

              <!-- Value props -->
              <ul class="space-y-2.5 mb-6">
                <li class="flex items-center gap-2.5 text-sm text-text-sub">
                  <span class="w-5 h-5 flex items-center justify-center rounded-full bg-green-50 text-green-500 shrink-0">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </span>
                  Understand your tax & compliance needs
                </li>
                <li class="flex items-center gap-2.5 text-sm text-text-sub">
                  <span class="w-5 h-5 flex items-center justify-center rounded-full bg-green-50 text-green-500 shrink-0">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </span>
                  Get a clear plan & transparent pricing
                </li>
                <li class="flex items-center gap-2.5 text-sm text-text-sub">
                  <span class="w-5 h-5 flex items-center justify-center rounded-full bg-green-50 text-green-500 shrink-0">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </span>
                  Typically responds within 30 minutes
                </li>
              </ul>

              <!-- CTA -->
              <a
                href={`https://wa.me/${contact.whatsappNumber}?text=${encodeURIComponent('Hi N Accounts, I would like to book a free consultation.')}`}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center gap-2 w-full py-3.5 bg-whatsapp text-white font-semibold rounded-pill text-sm hover:brightness-110 transition-all duration-200 shadow-wa"
              >
                <MessageCircle class="w-4 h-4" />
                Book via WhatsApp
              </a>

              <!-- Trust line -->
              <p class="text-center text-[11px] text-text-mid mt-3">
                <span class="inline-flex items-center gap-1">
                  <svg class="w-3 h-3 text-amber" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  Rated 4.8/5 on Google &middot; 100+ clients served
                </span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
