---
import { GraduationCap, Globe, MapPin, IndianRupee, ShieldCheck } from 'lucide-astro'

const badges = [
  { icon: GraduationCap, label: 'Qualified Professionals' },
  { icon: Globe, label: '100% Online Service' },
  { icon: MapPin, label: 'Pan-India Reach' },
  { icon: IndianRupee, label: 'Affordable Pricing' },
  { icon: ShieldCheck, label: 'Accurate & Compliant' },
]
---

<section class="border-y border-gray-200 bg-white py-4">
  <div class="container">
    <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 md:gap-x-12">
      {badges.map((badge) => (
        <div class="flex items-center gap-2">
          <badge.icon class="w-5 h-5 text-amber shrink-0" />
          <span class="text-sm font-medium text-navy whitespace-nowrap">{badge.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
