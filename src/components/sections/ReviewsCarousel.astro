---
import reviews from '@data/reviews.json'
import ReviewCard from '@components/cards/ReviewCard.astro'
import SectionHeading from '@components/ui/SectionHeading.astro'
import { Star } from 'lucide-astro'
import { contact } from '@data/contact'

// Duplicate for seamless marquee loop
const allReviews = [...reviews, ...reviews]
---

<section class="section-py bg-white overflow-hidden" data-reveal>
  <div class="container">
    <SectionHeading
      label="Testimonials"
      heading="What Our Clients Say"
      sub="Hear from individuals and businesses we've helped across India."
    />

    <!-- Rating badge -->
    <div class="flex items-center justify-center gap-2 mb-8">
      <div class="flex items-center gap-0.5" role="img" aria-label="Rated 4.8 out of 5 stars">
        {Array.from({ length: 5 }).map(() => (
          <Star class="w-5 h-5 text-amber fill-amber" />
        ))}
      </div>
      <span class="text-sm font-medium text-navy">4.8 on Google</span>
    </div>
  </div>

  <!-- Marquee track — full viewport width -->
  <div class="relative" aria-label="Client reviews" role="region">
    <!-- Pause / Play button -->
    <button
      id="marquee-toggle"
      class="absolute top-2 right-4 z-10 flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-text-mid bg-white/90 backdrop-blur-sm border border-gray-200 rounded-pill hover:text-navy hover:border-gray-300 transition-all"
      aria-label="Pause reviews carousel"
    >
      <span id="marquee-icon" class="w-3 h-3 flex items-center justify-center">⏸</span>
      <span id="marquee-label">Pause</span>
    </button>
    <div id="marquee-track" class="flex gap-4 animate-marquee no-scrollbar" style="width: max-content;">
      {allReviews.map((review) => (
        <ReviewCard
          name={review.name}
          rating={review.rating}
          text={review.text}
          date={review.date}
        />
      ))}
    </div>
  </div>

  <script>
    const toggle = document.getElementById('marquee-toggle')
    const track = document.getElementById('marquee-track')
    const icon = document.getElementById('marquee-icon')
    const label = document.getElementById('marquee-label')
    let paused = false

    toggle?.addEventListener('click', () => {
      paused = !paused
      if (track) track.style.animationPlayState = paused ? 'paused' : 'running'
      if (icon) icon.textContent = paused ? '▶' : '⏸'
      if (label) label.textContent = paused ? 'Play' : 'Pause'
      toggle.setAttribute('aria-label', paused ? 'Play reviews carousel' : 'Pause reviews carousel')
    })
  </script>

  <!-- Google link -->
  <div class="container text-center mt-8">
    <a
      href={contact.mapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 text-sm font-semibold text-amber hover:text-amber-dark transition-colors"
    >
      See all reviews on Google
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </a>
  </div>
</section>
