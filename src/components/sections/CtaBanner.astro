---
import Button from '@components/ui/Button.astro'
import { contactInfo } from '@data/navigation'
import { Phone, MessageCircle, ArrowRight } from 'lucide-astro'
---

<section class="bg-amber-gradient">
  <div class="container py-12 lg:py-16 text-center">
    <h2 class="font-heading font-bold text-2xl md:text-3xl text-white mb-3 text-balance">
      Have Questions? We Are Here to Help.
    </h2>
    <p class="text-base text-white/80 mb-8 max-w-xl mx-auto">
      Get in touch for a free consultation &mdash; let us understand your needs and guide you to the right solution.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
      <Button href={contactInfo.phoneHref} variant="ghost" size="lg">
        <Phone class="w-4 h-4" />
        Call Us
      </Button>
      <Button
        href={`https://wa.me/${contactInfo.whatsappNumber}?text=${encodeURIComponent('Hi N Accounts, I am interested in your services.')}`}
        variant="ghost"
        size="lg"
        target="_blank"
        rel="noopener noreferrer"
      >
        <MessageCircle class="w-4 h-4" />
        WhatsApp Us
      </Button>
      <Button href="/contact/" variant="ghost" size="lg">
        Send an Enquiry
        <ArrowRight class="w-4 h-4" />
      </Button>
    </div>
  </div>
</section>
