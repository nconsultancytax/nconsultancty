---
const stats = [
  { value: '100+', label: 'Clients Served' },
  { value: '12+', label: 'Services' },
  { value: '3+', label: 'Years in Practice' },
  { value: '100%', label: 'Online Service' },
]
---

<div class="grid grid-cols-2 md:grid-cols-4 gap-6 py-8">
  {stats.map((stat) => (
    <div class="text-center">
      <p class="font-heading font-bold text-3xl md:text-4xl text-amber mb-1">
        {stat.value}
      </p>
      <p class="text-sm text-text-mid">{stat.label}</p>
    </div>
  ))}
</div>
