---
import Breadcrumb from '@components/layout/Breadcrumb.astro'

interface BreadcrumbItem {
  label: string
  href: string
}

interface Props {
  heading: string
  sub?: string
  breadcrumbItems?: BreadcrumbItem[]
}

const { heading, sub, breadcrumbItems } = Astro.props
---

<section class="bg-navy-gradient py-12 lg:py-16">
  <div class="container text-center">
    {breadcrumbItems && (
      <div class="flex justify-center mb-4">
        <Breadcrumb items={breadcrumbItems} />
      </div>
    )}

    <h1 class="font-heading font-bold text-2xl md:text-3xl lg:text-4xl text-white text-balance">
      {heading}
    </h1>

    {sub && (
      <p class="mt-3 text-base lg:text-lg text-white/70 max-w-2xl mx-auto">
        {sub}
      </p>
    )}
  </div>
</section>
