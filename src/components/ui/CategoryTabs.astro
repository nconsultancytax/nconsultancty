---
interface TabItem {
  id: string
  label: string
}

interface Props {
  tabs: readonly TabItem[] | TabItem[]
  activeTab?: string
  dataAttr?: string
}

const { tabs, activeTab = 'all', dataAttr = 'category' } = Astro.props
---

<style>
  /*
    CategoryTabs — active/inactive/hover colours via CSS variables + aria-selected.
    Decouples styling from JavaScript: the script only toggles aria-selected,
    CSS handles all visual states.
  */

  .tab-btn {
    background-color: var(--tabs-inactive-bg);
    color: var(--tabs-inactive-text);
    border-radius: var(--tabs-radius);
    transition: var(--tabs-transition);
  }
  .tab-btn:hover {
    background-color: var(--tabs-inactive-hover-bg);
  }
  .tab-btn[aria-selected="true"] {
    background-color: var(--tabs-active-bg);
    color: var(--tabs-active-text);
  }
</style>

<div class="flex flex-wrap gap-2 mb-8" role="tablist" aria-label="Filter categories">
  {tabs.map((tab) => (
    <button
      role="tab"
      class="tab-btn px-4 py-2 text-sm font-medium"
      data-tab={tab.id}
      data-filter={dataAttr}
      aria-selected={tab.id === activeTab ? 'true' : 'false'}
    >
      {tab.label}
    </button>
  ))}
</div>

<script>
  document.querySelectorAll('.tab-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const tabGroup = btn.getAttribute('data-filter') || 'category'
      const tabId = btn.getAttribute('data-tab')

      // Update active states within same tab group (aria-selected only — CSS handles visuals)
      document.querySelectorAll(`.tab-btn[data-filter="${tabGroup}"]`).forEach((t) => {
        t.setAttribute('aria-selected', 'false')
      })
      btn.setAttribute('aria-selected', 'true')

      // Filter items
      document.querySelectorAll(`[data-${tabGroup}]`).forEach((item) => {
        if (!(item as HTMLElement).classList.contains('tab-btn')) {
          const itemCategory = item.getAttribute(`data-${tabGroup}`)
          if (tabId === 'all' || itemCategory === tabId) {
            (item as HTMLElement).style.display = ''
          } else {
            (item as HTMLElement).style.display = 'none'
          }
        }
      })
    })
  })
</script>
