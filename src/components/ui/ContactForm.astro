---
import { services } from '@data/services'
import { Send, Loader2, Lock } from 'lucide-astro'
---

<form
  id="contact-form"
  class="space-y-5"
  novalidate
>
  <!-- Name -->
  <div>
    <label for="cf-name" class="block text-sm font-medium text-text-dark mb-1.5">
      Your Name <span class="text-error">*</span>
    </label>
    <input
      type="text"
      id="cf-name"
      name="name"
      required
      autocomplete="name"
      class="w-full h-12 px-4 border border-gray-300 rounded text-base focus:border-amber focus:ring-2 focus:ring-amber/15 outline-none transition-all"
      placeholder="Enter your full name"
    />
    <p class="form-error hidden text-xs text-error mt-1">Please enter your name.</p>
  </div>

  <!-- Email -->
  <div>
    <label for="cf-email" class="block text-sm font-medium text-text-dark mb-1.5">
      Email Address <span class="text-error">*</span>
    </label>
    <input
      type="email"
      id="cf-email"
      name="email"
      required
      autocomplete="email"
      class="w-full h-12 px-4 border border-gray-300 rounded text-base focus:border-amber focus:ring-2 focus:ring-amber/15 outline-none transition-all"
      placeholder="you@example.com"
    />
    <p class="form-error hidden text-xs text-error mt-1">Please enter a valid email address.</p>
  </div>

  <!-- Phone -->
  <div>
    <label for="cf-phone" class="block text-sm font-medium text-text-dark mb-1.5">
      Phone / WhatsApp Number <span class="text-error">*</span>
    </label>
    <input
      type="tel"
      id="cf-phone"
      name="phone"
      required
      autocomplete="tel"
      class="w-full h-12 px-4 border border-gray-300 rounded text-base focus:border-amber focus:ring-2 focus:ring-amber/15 outline-none transition-all"
      placeholder="+91 XXXXX XXXXX"
    />
    <p class="form-error hidden text-xs text-error mt-1">Please enter your phone number.</p>
  </div>

  <!-- Service dropdown -->
  <div>
    <label for="cf-service" class="block text-sm font-medium text-text-dark mb-1.5">
      Service You Are Interested In
    </label>
    <select
      id="cf-service"
      name="service"
      class="w-full h-12 px-4 border border-gray-300 rounded text-base bg-white focus:border-amber focus:ring-2 focus:ring-amber/15 outline-none transition-all"
    >
      <option value="">Select a service</option>
      <option value="General Enquiry">General Enquiry</option>
      {services.map((s) => (
        <option value={s.name}>{s.name}</option>
      ))}
    </select>
  </div>

  <!-- Message -->
  <div>
    <label for="cf-message" class="block text-sm font-medium text-text-dark mb-1.5">
      Your Message <span class="text-error">*</span>
    </label>
    <textarea
      id="cf-message"
      name="message"
      required
      rows="4"
      class="w-full px-4 py-3 border border-gray-300 rounded text-base resize-y min-h-[120px] focus:border-amber focus:ring-2 focus:ring-amber/15 outline-none transition-all"
      placeholder="Tell us how we can help you..."
    ></textarea>
    <p class="form-error hidden text-xs text-error mt-1">Please enter your message.</p>
  </div>

  <!-- Submit -->
  <button
    type="submit"
    class="btn-primary w-full sm:w-auto min-h-[48px]"
  >
    <span id="submit-text" class="inline-flex items-center gap-2">
      <Send class="w-4 h-4" />
      Send Message
    </span>
    <span id="submit-loading" class="hidden inline-flex items-center gap-2">
      <Loader2 class="w-4 h-4 animate-spin" />
      Sending...
    </span>
  </button>

  <!-- Privacy note -->
  <p class="flex items-center gap-1.5 text-xs text-text-mid">
    <Lock class="w-3.5 h-3.5" />
    Your details are safe with us and will never be shared.
  </p>

  <!-- Success message (hidden by default) -->
  <div id="form-success" class="hidden p-4 bg-success/10 border border-success/30 rounded-card text-center">
    <p class="font-heading font-semibold text-success">Message Sent!</p>
    <p class="text-sm text-text-mid mt-1">Thank you for reaching out. We will get back to you within 24 hours.</p>
  </div>

  <!-- Error message (hidden by default) -->
  <div id="form-error-msg" class="hidden p-4 bg-error/10 border border-error/30 rounded-card text-center">
    <p class="font-heading font-semibold text-error">Something went wrong.</p>
    <p class="text-sm text-text-mid mt-1">Please try again or contact us via WhatsApp.</p>
  </div>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault()

      // Reset errors
      form.querySelectorAll('.form-error').forEach((el) => el.classList.add('hidden'))
      document.getElementById('form-error-msg')?.classList.add('hidden')

      // Validate
      const name = (form.querySelector('#cf-name') as HTMLInputElement).value.trim()
      const email = (form.querySelector('#cf-email') as HTMLInputElement).value.trim()
      const phone = (form.querySelector('#cf-phone') as HTMLInputElement).value.trim()
      const message = (form.querySelector('#cf-message') as HTMLTextAreaElement).value.trim()
      const service = (form.querySelector('#cf-service') as HTMLSelectElement).value

      let valid = true

      if (!name) {
        showError('#cf-name')
        valid = false
      }
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showError('#cf-email')
        valid = false
      }
      if (!phone) {
        showError('#cf-phone')
        valid = false
      }
      if (!message) {
        showError('#cf-message')
        valid = false
      }

      if (!valid) return

      // Show loading state
      const submitText = document.getElementById('submit-text')
      const submitLoading = document.getElementById('submit-loading')
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement
      submitText?.classList.add('hidden')
      submitLoading?.classList.remove('hidden')
      submitBtn.disabled = true

      try {
        const apiKey = (import.meta as any).env?.PUBLIC_WEB3FORMS_KEY || ''
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            access_key: apiKey,
            subject: 'New Enquiry — N Accounts & Tax Consultancy',
            name,
            email,
            phone,
            service: service || 'Not specified',
            message,
          }),
        })
        const data = await res.json()

        if (data.success) {
          form.reset()
          document.getElementById('form-success')?.classList.remove('hidden')
          window.dataLayer?.push({ event: 'contact_form_submit' })
        } else {
          document.getElementById('form-error-msg')?.classList.remove('hidden')
        }
      } catch {
        document.getElementById('form-error-msg')?.classList.remove('hidden')
      } finally {
        submitText?.classList.remove('hidden')
        submitLoading?.classList.add('hidden')
        submitBtn.disabled = false
      }
    })
  }

  function showError(selector: string) {
    const field = document.querySelector(selector) as HTMLElement
    const error = field?.parentElement?.querySelector('.form-error')
    error?.classList.remove('hidden')
    field?.classList.add('border-error')
    field?.addEventListener('input', () => {
      error?.classList.add('hidden')
      field.classList.remove('border-error')
    }, { once: true })
  }
</script>
