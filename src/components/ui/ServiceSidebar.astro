---
import { contactInfo } from '@data/navigation'
import { Phone, MessageCircle, CheckCircle } from 'lucide-astro'
import Button from './Button.astro'

interface Props {
  serviceSlug: string
}

const { serviceSlug } = Astro.props
const waUrl = `https://wa.me/${contactInfo.whatsappNumber}?text=${encodeURIComponent(`Hi N Accounts, I am interested in your ${serviceSlug.replace(/-/g, ' ')} service.`)}`
---

<div class="lg:sticky lg:top-24">
  <div class="bg-bg-light border border-gray-200 rounded-card-lg p-6 space-y-5">
    <h3 class="font-heading font-semibold text-lg text-navy">
      Ready to get started?
    </h3>

    <!-- Enquire button -->
    <Button href="/contact/" variant="primary" size="lg" class="w-full">
      Enquire Now
    </Button>

    <hr class="border-gray-200" />

    <!-- Contact links -->
    <div class="space-y-3">
      <a
        href={contactInfo.phoneHref}
        class="flex items-center gap-3 text-sm text-text-dark hover:text-amber transition-colors"
      >
        <Phone class="w-4 h-4 text-amber" />
        {contactInfo.phone}
      </a>
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-3 text-sm text-text-dark hover:text-whatsapp transition-colors"
      >
        <MessageCircle class="w-4 h-4 text-whatsapp" />
        WhatsApp Us
      </a>
    </div>

    <hr class="border-gray-200" />

    <!-- Trust points -->
    <ul class="space-y-2">
      {['Free initial guidance', '100% online process', 'Accurate & compliant'].map((item) => (
        <li class="flex items-center gap-2 text-sm text-text-mid">
          <CheckCircle class="w-4 h-4 text-success shrink-0" />
          {item}
        </li>
      ))}
    </ul>
  </div>
</div>
