---
interface Props {
  label?: string
  heading: string
  sub?: string
  align?: 'center' | 'left'
  dark?: boolean
}

const { label, heading, sub, align = 'center', dark = false } = Astro.props

const alignClass = align === 'center' ? 'text-center mx-auto' : 'text-left'
const headingColor = dark ? 'text-white' : 'text-navy'
const subColor = dark ? 'text-white/70' : 'text-text-mid'
---

<div class={`max-w-3xl mb-10 lg:mb-12 ${alignClass}`}>
  {label && (
    <span class="label-pill mb-3 inline-block">{label}</span>
  )}
  <h2 class={`font-heading font-bold text-2xl md:text-3xl lg:text-4xl ${headingColor} text-balance`}>
    {heading}
  </h2>
  {sub && (
    <p class={`mt-3 text-base lg:text-lg ${subColor}`}>
      {sub}
    </p>
  )}
</div>
