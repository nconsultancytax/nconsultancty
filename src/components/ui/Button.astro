---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'whatsapp'
  href?: string
  size?: 'sm' | 'md' | 'lg'
  class?: string
  target?: string
  rel?: string
  ariaLabel?: string
  type?: 'button' | 'submit'
}

const {
  variant = 'primary',
  href,
  size = 'md',
  class: className = '',
  target,
  rel,
  ariaLabel,
  type = 'button',
} = Astro.props

const sizeClasses: Record<string, string> = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-3 text-sm',
  lg: 'px-8 py-3.5 text-base',
}

const variantClasses: Record<string, string> = {
  primary: 'bg-amber text-white hover:bg-amber-dark btn-variant-primary',
  secondary: 'border-2 border-navy text-navy hover:bg-navy hover:text-white',
  ghost: 'border-2 border-white text-white hover:bg-white hover:text-navy',
  whatsapp: 'bg-whatsapp text-white hover:opacity-90 btn-variant-whatsapp',
}

const base = 'inline-flex items-center justify-center gap-2 font-heading font-semibold rounded-pill transition-all duration-200 min-h-[48px]'
const classes = `${base} ${sizeClasses[size]} ${variantClasses[variant]} ${className}`

const Tag = href ? 'a' : 'button'
---

<style>
  /* Shadow states driven by CSS variables — Tailwind can't do per-variant hover shadows */
  .btn-variant-primary {
    box-shadow: var(--btn-primary-shadow);
  }
  .btn-variant-primary:hover {
    box-shadow: var(--btn-primary-shadow-hover);
    transform: translateY(-1px);
  }

  .btn-variant-whatsapp {
    box-shadow: var(--btn-wa-shadow);
  }
</style>

{href ? (
  <a
    href={href}
    class={classes}
    target={target}
    rel={rel}
    aria-label={ariaLabel}
  >
    <slot />
  </a>
) : (
  <button
    type={type}
    class={classes}
    aria-label={ariaLabel}
  >
    <slot />
  </button>
)}
