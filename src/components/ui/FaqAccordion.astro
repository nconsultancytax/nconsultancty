---
import type { FaqItem } from '@data/faqs'
import { Plus, Minus } from 'lucide-astro'

interface Props {
  items: FaqItem[]
  firstOpen?: boolean
}

const { items, firstOpen = true } = Astro.props
---

<style>
  /*
    FaqAccordion — hover and colour states via CSS variables.
    Tailwind handles: layout, padding, sizing, transitions.
    CSS variables handle: divider colour, text colour on hover.
    Replaces group-hover:* Tailwind utilities.
  */

  /* Divider between FAQ items */
  .faq-list > * + * {
    border-top: 1px solid var(--faq-divider);
  }

  /* Question text */
  .faq-question {
    color: var(--faq-question-color);
    transition: color 0.2s ease;
  }
  .faq-trigger:hover .faq-question {
    color: var(--faq-question-hover);
  }

  /* Icon */
  .faq-icon {
    color: var(--faq-icon-color);
    transition: color 0.2s ease;
  }
  .faq-trigger:hover .faq-icon {
    color: var(--faq-icon-hover);
  }

  /* Answer text */
  .faq-answer {
    color: var(--faq-answer-color);
  }
</style>

<div class="faq-list">
  {items.map((item, index) => {
    const panelId = `faq-panel-${item.id}`
    return (
    <div class="faq-item" data-faq-id={item.id}>
      <button
        class="faq-trigger flex items-center justify-between w-full py-5 text-left"
        aria-expanded={firstOpen && index === 0 ? 'true' : 'false'}
        aria-controls={panelId}
      >
        <span class="faq-question font-heading font-semibold text-base pr-4">
          {item.question}
        </span>
        <span class="faq-icon shrink-0 w-6 h-6 flex items-center justify-center">
          <Plus class="w-5 h-5 faq-icon-plus" />
          <Minus class="w-5 h-5 faq-icon-minus hidden" />
        </span>
      </button>
      <div
        id={panelId}
        role="region"
        aria-labelledby={`faq-btn-${item.id}`}
        class={`faq-panel overflow-hidden transition-all duration-300 ${
          firstOpen && index === 0 ? 'max-h-[500px] opacity-100' : 'max-h-0 opacity-0'
        }`}
      >
        <p class="faq-answer pb-5 text-sm leading-relaxed">
          {item.answer}
        </p>
      </div>
    </div>
    )
  })}
</div>

<script>
  document.querySelectorAll('.faq-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true'
      const panel = btn.nextElementSibling as HTMLElement
      const plusIcon = btn.querySelector('.faq-icon-plus') as HTMLElement
      const minusIcon = btn.querySelector('.faq-icon-minus') as HTMLElement

      // Toggle state
      btn.setAttribute('aria-expanded', String(!expanded))

      if (expanded) {
        panel.style.maxHeight = '0'
        panel.style.opacity = '0'
        plusIcon?.classList.remove('hidden')
        minusIcon?.classList.add('hidden')
      } else {
        panel.style.maxHeight = panel.scrollHeight + 'px'
        panel.style.opacity = '1'
        plusIcon?.classList.add('hidden')
        minusIcon?.classList.remove('hidden')

        // Fire analytics
        const faqId = btn.closest('.faq-item')?.getAttribute('data-faq-id')
        window.dataLayer?.push({ event: 'faq_expand', question_id: faqId })
      }
    })
  })

  // Set initial state for first-open items
  document.querySelectorAll('.faq-trigger[aria-expanded="true"]').forEach((btn) => {
    const plusIcon = btn.querySelector('.faq-icon-plus') as HTMLElement
    const minusIcon = btn.querySelector('.faq-icon-minus') as HTMLElement
    plusIcon?.classList.add('hidden')
    minusIcon?.classList.remove('hidden')
  })
</script>
