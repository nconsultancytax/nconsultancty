---
import {
  GraduationCap,
  Monitor,
  MapPin,
  ShieldCheck,
  IndianRupee,
  Heart,
  CheckCircle,
} from 'lucide-astro'

interface Props {
  icon: string
  title: string
  desc: string
  variant?: 'light' | 'dark'
}

const { icon, title, desc, variant = 'dark' } = Astro.props

// Static icon map — only the icons used by WhyChooseUs.astro (no import *)
const iconMap: Record<string, any> = {
  GraduationCap,
  Monitor,
  MapPin,
  ShieldCheck,
  IndianRupee,
  Heart,
  CheckCircle,
}

const IconComponent = iconMap[icon] ?? CheckCircle
---

<style>
  /*
    WhyChooseCard — variant colours via CSS variables + data-variant attribute.
    Removes all JavaScript class-building; CSS handles dark/light styling.
    Tailwind handles: layout, padding, border-radius, sizing, transitions.
  */

  /* Dark variant (on primary gradient background) */
  .why-card[data-variant="dark"] {
    background-color: var(--why-card-dark-bg);
  }
  .why-card[data-variant="dark"]:hover {
    background-color: var(--why-card-dark-bg-hover);
  }
  .why-card[data-variant="dark"] .why-card-icon {
    background-color: var(--why-card-dark-icon-bg);
  }
  .why-card[data-variant="dark"] .why-card-title {
    color: var(--why-card-dark-text);
  }
  .why-card[data-variant="dark"] .why-card-desc {
    color: var(--why-card-dark-desc);
  }

  /* Light variant */
  .why-card[data-variant="light"] {
    background-color: var(--why-card-light-bg);
  }
  .why-card[data-variant="light"]:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }
  .why-card[data-variant="light"] .why-card-icon {
    background-color: var(--why-card-light-icon-bg);
  }
  .why-card[data-variant="light"] .why-card-title {
    color: var(--why-card-light-text);
  }
  .why-card[data-variant="light"] .why-card-desc {
    color: var(--why-card-light-desc);
  }

  /* Icon accent colour is shared across both variants */
  .why-card-icon {
    color: var(--card-icon-accent);
  }
</style>

<div
  class="why-card p-6 rounded-card-lg transition-all duration-200"
  data-variant={variant}
>
  <div class="why-card-icon w-10 h-10 flex items-center justify-center rounded-card mb-4">
    <IconComponent class="w-5 h-5" />
  </div>
  <h3 class="why-card-title font-heading font-semibold text-base mb-2">
    {title}
  </h3>
  <p class="why-card-desc text-sm leading-relaxed">
    {desc}
  </p>
</div>
