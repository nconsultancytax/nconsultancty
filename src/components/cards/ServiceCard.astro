---
import {
  ArrowRight,
  FileText,
  Calculator,
  FileCheck,
  BarChart3,
  BookOpen,
  Building2,
  Handshake,
  Globe,
  Award,
  KeyRound,
  CreditCard,
  Shield,
} from 'lucide-astro'

interface Props {
  name: string
  slug: string
  icon: string
  shortDesc: string
  category: string
}

const { name, slug, icon, shortDesc, category } = Astro.props

// Static icon map — only the icons used by services.ts (no import *)
const iconMap: Record<string, any> = {
  FileText,
  Calculator,
  FileCheck,
  BarChart3,
  BookOpen,
  Building2,
  Handshake,
  Globe,
  Award,
  KeyRound,
  CreditCard,
  Shield,
}

const IconComponent = iconMap[icon] ?? FileText
---

<style>
  /*
    ServiceCard — hover state colours via CSS variables.
    Tailwind handles: layout, spacing, sizing, border-width, transitions.
    CSS variables handle: colour changes on hover (replacing group-hover:* utilities).
  */

  .svc-card {
    border-color: var(--svc-card-border);
  }
  .svc-card:hover {
    border-color: var(--svc-card-border-hover);
  }

  .svc-icon-wrap {
    background-color: var(--svc-card-icon-bg);
    color: var(--svc-card-icon-color);
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .svc-card:hover .svc-icon-wrap {
    background-color: var(--svc-card-icon-bg-hover);
    color: var(--svc-card-icon-color-hover);
  }

  .svc-title {
    color: var(--svc-card-title-color);
    transition: color 0.2s ease;
  }
  .svc-card:hover .svc-title {
    color: var(--svc-card-title-hover);
  }

  .svc-desc {
    color: var(--svc-card-desc-color);
  }

  .svc-cta {
    color: var(--svc-card-cta-color);
  }
</style>

<a
  href={`/services/${slug}/`}
  class="card svc-card group flex flex-col p-4 border transition-all duration-200 h-full"
  data-category={category}
>
  <!-- Header: Icon + Title inline -->
  <div class="flex items-center gap-2.5 mb-2">
    <div class="svc-icon-wrap w-9 h-9 flex items-center justify-center rounded-card shrink-0">
      <IconComponent class="w-[18px] h-[18px]" />
    </div>
    <h3 class="svc-title font-heading font-semibold text-sm leading-snug">
      {name}
    </h3>
  </div>

  <!-- Description -->
  <p class="svc-desc text-xs leading-relaxed line-clamp-2 mb-3">
    {shortDesc}
  </p>

  <!-- CTA -->
  <span class="svc-cta mt-auto inline-flex items-center gap-1 text-xs font-medium group-hover:gap-2 transition-all duration-200">
    Enquire
    <ArrowRight class="w-3 h-3" />
  </span>
</a>
