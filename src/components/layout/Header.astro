---
import { mainNav, dropdownGroups } from '@data/navigation'
import { contact } from '@data/contact'
import LanguageToggle from './LanguageToggle.astro'
import ServicesDropdown from './ServicesDropdown.astro'
import MobileDrawer from './MobileDrawer.astro'
import { Phone, MessageCircle, Menu } from 'lucide-astro'
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-white shadow-nav"
>
  <div class="container flex items-center justify-between h-15 lg:h-18">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 shrink-0" aria-label="N Accounts & Tax Consultancy — Home">
      <span class="font-heading font-bold text-lg lg:text-xl text-navy">
        N Accounts<span class="text-amber">&</span>Tax
      </span>
    </a>

    <!-- Desktop navigation -->
    <nav class="hidden lg:flex items-center gap-6" aria-label="Main navigation">
      {mainNav.map((item) => (
        item.children ? (
          <div class="relative group">
            <a
              href={item.href}
              class="inline-flex items-center gap-1 py-2 text-sm font-medium text-text-dark hover:text-amber transition-colors"
            >
              {item.label}
              <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
            <ServicesDropdown groups={dropdownGroups} />
          </div>
        ) : (
          <a
            href={item.href}
            class="py-2 text-sm font-medium text-text-dark hover:text-amber transition-colors"
          >
            {item.label}
          </a>
        )
      ))}
    </nav>

    <!-- Right actions -->
    <div class="flex items-center gap-3">
      <LanguageToggle />

      <!-- WhatsApp CTA (desktop) -->
      <a
        href={`https://wa.me/${contact.whatsappNumber}?text=${encodeURIComponent('Hi N Accounts, I am interested in your services.')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden lg:inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold text-white bg-whatsapp rounded-pill hover:opacity-90 transition-opacity"
        aria-label="Chat on WhatsApp"
      >
        <MessageCircle class="w-4 h-4" />
        WhatsApp
      </a>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 -mr-2 text-navy"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <Menu class="w-6 h-6" />
      </button>
    </div>
  </div>
</header>

<!-- Mobile drawer -->
<MobileDrawer />

<!-- Spacer to offset fixed header -->
<div class="h-15 lg:h-18" aria-hidden="true"></div>

<script>
  // Header scroll behaviour: add shadow on scroll
  const header = document.getElementById('site-header')
  if (header) {
    let lastScroll = 0
    window.addEventListener('scroll', () => {
      const currentScroll = window.scrollY
      if (currentScroll > 10) {
        header.classList.add('shadow-nav')
      } else {
        header.classList.remove('shadow-nav')
      }
      lastScroll = currentScroll
    }, { passive: true })
  }
</script>
