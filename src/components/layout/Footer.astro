---
import { footerQuickLinks, footerServiceLinks, legalLinks, contactInfo } from '@data/navigation'
import { Phone, Mail, MapPin } from 'lucide-astro'
---

<footer class="bg-navy-gradient text-white">
  <!-- Main footer -->
  <div class="container py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10">

      <!-- Col 1: Brand -->
      <div class="lg:col-span-1">
        <a href="/" class="inline-block mb-4">
          <span class="font-heading font-bold text-xl">
            N Accounts<span class="text-amber">&</span>Tax
          </span>
        </a>
        <p class="text-sm text-white/60 italic mb-3">
          Act Wise & Act Precise on Your Finances
        </p>
        <p class="text-sm text-white/50 leading-relaxed">
          Professional accounting and tax services for individuals and businesses across India.
        </p>
      </div>

      <!-- Col 2: Quick Links -->
      <div>
        <h3 class="font-heading font-semibold text-white mb-4">Quick Links</h3>
        <ul class="space-y-2">
          {footerQuickLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-white/60 hover:text-amber transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Services -->
      <div>
        <h3 class="font-heading font-semibold text-white mb-4">Our Services</h3>
        <ul class="space-y-2">
          {footerServiceLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-white/60 hover:text-amber transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Contact -->
      <div>
        <h3 class="font-heading font-semibold text-white mb-4">Contact Us</h3>
        <ul class="space-y-3">
          <li>
            <a
              href={contactInfo.phoneHref}
              class="flex items-start gap-2 text-sm text-white/60 hover:text-amber transition-colors"
            >
              <Phone class="w-4 h-4 mt-0.5 shrink-0" />
              {contactInfo.phone}
            </a>
          </li>
          <li>
            <a
              href={`mailto:${contactInfo.email}`}
              class="flex items-start gap-2 text-sm text-white/60 hover:text-amber transition-colors"
            >
              <Mail class="w-4 h-4 mt-0.5 shrink-0" />
              {contactInfo.email}
            </a>
          </li>
          <li>
            <a
              href={contactInfo.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-start gap-2 text-sm text-white/60 hover:text-amber transition-colors"
            >
              <MapPin class="w-4 h-4 mt-0.5 shrink-0" />
              <span>{contactInfo.address}</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/10">
    <div class="container py-4 flex flex-col md:flex-row items-center justify-between gap-3 text-xs text-white/40">
      <p>&copy; 2026 N Accounts & Tax Consultancy. All rights reserved.</p>
      <div class="flex items-center gap-4">
        {legalLinks.map((link) => (
          <a href={link.href} class="hover:text-white/70 transition-colors">
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
