---
import PageLayout from '@layouts/PageLayout.astro'
import PageHero from '@components/sections/PageHero.astro'

const breadcrumbItems = [{ label: 'Terms of Use', href: '' }]
---

<PageLayout title="Terms of Use" description="Terms of Use for N Accounts & Tax Consultancy website and services.">
  <PageHero heading="Terms of Use" sub="Last updated: February 2026" breadcrumbItems={breadcrumbItems} />

  <section class="section-py bg-white">
    <div class="container max-w-3xl">
      <div class="prose prose-navy max-w-none space-y-8">
        <div>
          <h2 class="font-heading font-semibold text-xl text-navy mb-3">1. Scope of Services</h2>
          <p class="text-sm text-text-mid leading-relaxed">N Accounts & Tax Consultancy provides tax filing, accounting, and business registration services as described on this website. Our services are intended for individuals and businesses operating within the jurisdiction of Indian tax and regulatory law.</p>
        </div>
        <div>
          <h2 class="font-heading font-semibold text-xl text-navy mb-3">2. Client Responsibilities</h2>
          <p class="text-sm text-text-mid leading-relaxed">Clients are responsible for providing accurate and complete documents and information required for service delivery. Delays or inaccuracies in submissions may affect timelines and outcomes.</p>
        </div>
        <div>
          <h2 class="font-heading font-semibold text-xl text-navy mb-3">3. Delivery Timelines</h2>
          <p class="text-sm text-text-mid leading-relaxed">All delivery timelines mentioned on this website are indicative and subject to the processing speed of relevant government portals. We make every effort to complete services within the stated timeframes.</p>
        </div>
        <div>
          <h2 class="font-heading font-semibold text-xl text-navy mb-3">4. Limitation of Liability</h2>
          <p class="text-sm text-text-mid leading-relaxed">N Accounts & Tax Consultancy shall not be liable for any delays, errors, or penalties arising from incorrect information provided by the client or from government portal downtime or processing delays beyond our control.</p>
        </div>
        <div class="bg-bg-light rounded-card p-5">
          <p class="text-sm text-text-mid">Questions about these terms? Email us at <a href="mailto:nconsultancy.tax@gmail.com" class="text-amber hover:text-amber-dark">nconsultancy.tax@gmail.com</a></p>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
