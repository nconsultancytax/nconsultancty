---
import PageLayout from '@layouts/PageLayout.astro'
import PageHero from '@components/sections/PageHero.astro'
import CategoryTabs from '@components/ui/CategoryTabs.astro'
import FaqAccordion from '@components/ui/FaqAccordion.astro'
import CtaBanner from '@components/sections/CtaBanner.astro'
import { faqs, faqCategories } from '@data/faqs'
import { MessageCircle, Phone } from 'lucide-astro'

const breadcrumbItems = [{ label: 'FAQ', href: '' }]
---

<PageLayout
  title="Frequently Asked Questions"
  description="Find answers to common questions about ITR filing, GST registration, company registration, and our services."
>
  <PageHero
    heading="Frequently Asked Questions"
    sub="Quick answers to common questions about our services."
    breadcrumbItems={breadcrumbItems}
  />

  <section class="section-py bg-white">
    <div class="container max-w-3xl">
      <FaqAccordion items={faqs} firstOpen={true} />
    </div>
  </section>

  <CtaBanner />
</PageLayout>
