---
import PageLayout from '@layouts/PageLayout.astro'
import PageHero from '@components/sections/PageHero.astro'
import ContactForm from '@components/ui/ContactForm.astro'
import { contactInfo } from '@data/navigation'
import { Phone, Mail, MapPin, Clock, MessageCircle } from 'lucide-astro'

const breadcrumbItems = [{ label: 'Contact', href: '' }]
const mapsUrl = contactInfo.mapsEmbedUrl
---

<PageLayout
  title="Contact Us"
  description="Get in touch with N Accounts & Tax Consultancy. Call, WhatsApp, or send us an enquiry for a free consultation."
>
  <PageHero
    heading="Get in Touch"
    sub="We'd love to hear from you. Send us a message or reach out directly."
    breadcrumbItems={breadcrumbItems}
  />

  <section class="section-py bg-white">
    <div class="container">
      <div class="flex flex-col lg:flex-row gap-10 lg:gap-16">

        <!-- Left: Form -->
        <div class="w-full lg:w-[55%]">
          <h2 class="font-heading font-semibold text-xl text-navy mb-6">Send Us a Message</h2>
          <ContactForm />
        </div>

        <!-- Right: Contact details -->
        <div class="w-full lg:w-[45%]">
          <h2 class="font-heading font-semibold text-xl text-navy mb-6">Contact Details</h2>

          <div class="space-y-4">
            <!-- Phone -->
            <a
              href={contactInfo.phoneHref}
              class="flex items-start gap-4 p-4 bg-bg-light rounded-card hover:shadow-md transition-all duration-200 group"
            >
              <div class="w-10 h-10 flex items-center justify-center rounded-full bg-amber/10 text-amber shrink-0">
                <Phone class="w-5 h-5" />
              </div>
              <div>
                <p class="text-sm font-medium text-navy group-hover:text-amber transition-colors">Phone / WhatsApp</p>
                <p class="text-sm text-text-mid">{contactInfo.phone}</p>
              </div>
            </a>

            <!-- Email -->
            <a
              href={`mailto:${contactInfo.email}`}
              class="flex items-start gap-4 p-4 bg-bg-light rounded-card hover:shadow-md transition-all duration-200 group"
            >
              <div class="w-10 h-10 flex items-center justify-center rounded-full bg-amber/10 text-amber shrink-0">
                <Mail class="w-5 h-5" />
              </div>
              <div>
                <p class="text-sm font-medium text-navy group-hover:text-amber transition-colors">Email</p>
                <p class="text-sm text-text-mid">{contactInfo.email}</p>
              </div>
            </a>

            <!-- Address -->
            <a
              href={contactInfo.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-start gap-4 p-4 bg-bg-light rounded-card hover:shadow-md transition-all duration-200 group"
            >
              <div class="w-10 h-10 flex items-center justify-center rounded-full bg-amber/10 text-amber shrink-0">
                <MapPin class="w-5 h-5" />
              </div>
              <div>
                <p class="text-sm font-medium text-navy group-hover:text-amber transition-colors">Office Address</p>
                <p class="text-sm text-text-mid">{contactInfo.address}</p>
              </div>
            </a>

            <!-- Office Hours -->
            <div class="flex items-start gap-4 p-4 bg-bg-light rounded-card">
              <div class="w-10 h-10 flex items-center justify-center rounded-full bg-amber/10 text-amber shrink-0">
                <Clock class="w-5 h-5" />
              </div>
              <div>
                <p class="text-sm font-medium text-navy">Office Hours</p>
                <p class="text-sm text-text-mid">{contactInfo.officeHours.weekdays}</p>
                <p class="text-sm text-text-mid">{contactInfo.officeHours.weekend}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Google Maps -->
  {mapsUrl && (
    <section class="border-t border-gray-200">
      <iframe
        src={mapsUrl}
        width="100%"
        height="360"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="N Accounts & Tax Consultancy office location"
        class="w-full border-0"
      ></iframe>
    </section>
  )}
</PageLayout>
