# Contact Form (Web3Forms — get key at web3forms.com)
PUBLIC_WEB3FORMS_KEY=your_access_key_here

# Google Tag Manager (get container ID at tagmanager.google.com)
PUBLIC_GTM_ID=GTM-XXXXXXX

# Microsoft Clarity (get project ID at clarity.microsoft.com)
PUBLIC_CLARITY_ID=xxxxxxxxxx

# Google Maps embed URL (copy from Google Maps → Share → Embed a map → copy src URL)
PUBLIC_MAPS_EMBED_URL=https://www.google.com/maps/embed?pb=...

# Site domain (used for sitemap + OG tags)
PUBLIC_SITE_URL=https://www.naccountstax.com
